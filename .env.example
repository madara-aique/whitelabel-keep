# ─────────────────────────────────────────────────────────────
# Cash Kiosk — environment template
#
# Copy to .env.local for the app and .env for docker compose.
# Everything here is generic: no deployment-specific branding is
# baked into the source. Override per site.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# ── App identity (all user-visible copy comes from here) ─────
APP_NAME=Smart Locker
APP_OPERATOR_NAME=Locker Operations
APP_LOCALE=en-PH
APP_CURRENCY=PHP
APP_CURRENCY_SYMBOL=PHP
APP_SUPPORT_EMAIL=support@example.com
APP_SUPPORT_PHONE=+63 000 000 0000
APP_REFERENCE_PREFIX=REF
APP_TIMEZONE=Asia/Manila
APP_TIMEZONE_OFFSET_MINUTES=480

# ── Dockerized MongoDB (read by docker compose) ──────────────
MONGO_HOST_PORT=27019
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme123
MONGO_DB=whitelabel-keep
MONGO_EXPRESS_PORT=8081

# Read by the app (server-side only).
MONGODB_URI=mongodb://admin:changeme123@localhost:27019/whitelabel-keep?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=10

# ── Admin authentication (NextAuth v5) ───────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_TRUST_HOST=true
# Seed administrator, created by `npm run seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Barcode-scanner shortcut on the home screen that opens the admin area.
ADMIN_SCAN_CODE=admin-scan-code

# ── Hardware gateway (bill acceptor + locker doors) ──────────
# HARDWARE_DRIVER: "mock" runs the whole flow with no hardware attached;
# "socketio" talks to a physical controller gateway at HARDWARE_DEVICE_URL.
HARDWARE_DRIVER=mock
HARDWARE_ENABLED=true
# Port this app's own hardware gateway listens on (shares the Next port).
HARDWARE_SOCKET_PORT=4000
# Address of the physical controller gateway, e.g. http://10.0.0.50:4000
HARDWARE_DEVICE_URL=
HARDWARE_ACCESS_KEY=change-me-hardware-access-key
HARDWARE_SESSION_TTL_SECONDS=300
HARDWARE_CONNECT_TIMEOUT_MS=10000

# ── Locker controller (HTTP door actuation) ──────────────────
LOCKER_CONTROLLER_BASE_URL=http://localhost:9090
LOCKER_CONTROLLER_DOORS_PATH=/api/doors
LOCKER_CONTROLLER_LOCATION_PATH=/api/location
LOCKER_CONTROLLER_DOOR_PATH=/api/door
LOCKER_CONTROLLER_OPEN_ALL_PATH=/api/doors/open-all
LOCKER_CONTROLLER_TIMEOUT_MS=8000

# ── Kiosk behaviour ──────────────────────────────────────────
DOOR_RATE=250
BILL_ACCEPTOR_ENABLED=true
IDLE_TIMEOUT_SECONDS=120
MAX_ALIAS_LENGTH=8
PIN_LENGTH=6
# Denominations the acceptor will accept, as a JSON array.
ACCEPTED_BILLS=[50,100,200]

# ── Promo pricing window (ISO-8601, inclusive) ───────────────
PROMO_ENABLED=false
PROMO_START_DATE=
PROMO_END_DATE=
PROMO_RATE=0

# ── Payment gateway (e-wallet / QR) ──────────────────────────
# Confirmation is by polling PAYMENT_GATEWAY_STATUS_URL; there is no
# push channel, so no websocket URL is configured.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_STATUS_URL=
PAYMENT_GATEWAY_TIMEOUT_MS=15000

# ── Offline → online sync worker ─────────────────────────────
# Leave ONLINE_MONGO_URI empty to keep the kiosk fully offline.
ONLINE_MONGO_URI=
ONLINE_MONGO_DB=
SYNC_ENABLED=false
SYNC_RETRY_INTERVAL_MS=30000
SYNC_BATCH_SIZE=50
