{
  "name": "locker-kiosk",
  "version": "1.0.0",
  "private": true,
  "description": "Self-service locker kiosk: door selection, cash and e-wallet payment, and operator tooling.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:gateway": "tsx watch src/server/gateway.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "sync": "tsx scripts/sync-worker.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f mongodb",
    "db:shell": "docker compose exec mongodb mongosh -u admin -p changeme123 --authenticationDatabase admin whitelabel-keep",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.408.0",
    "mongodb": "^6.10.0",
    "mongoose": "^8.5.1",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-qr-code": "^2.0.12",
    "recharts": "^2.12.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
